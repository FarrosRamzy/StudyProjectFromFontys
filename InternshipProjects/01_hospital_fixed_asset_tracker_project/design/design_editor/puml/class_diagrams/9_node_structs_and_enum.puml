@startuml Network_Structs_And_RFID_Enum
 title Data Structs and RFID Enum
 skinparam classAttributeIconSize 0
 hide circle
 struct myNodeBootstrapConfig {
   +device_id : String
   +wifi_ssid : String
   +wifi_password : String
   +is_configured : bool
 }
 struct myNodeRemoteConfig {
   +role : String
   +hospital_name : String
   +room_name : String
   +mqtt_host : String
   +mqtt_port : uint16_t
